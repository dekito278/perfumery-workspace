{
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/orders/expire-reservations",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/products/:slug",
      "destination": "/catalog/:slug",
      "permanent": true
    },
    {
      "source": "/en/products/:slug",
      "destination": "/en/catalog/:slug",
      "permanent": true
    },
    {
      "source": "/mobile",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/mobile/home",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/mobile/dashboard",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/mobile/catalog",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/mobile/articles",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/mobile/products/:slug",
      "destination": "/catalog/:slug",
      "permanent": true
    },
    {
      "source": "/mobile/articles/:slug",
      "destination": "/articles/:slug",
      "permanent": true
    },
    {
      "source": "/mobile/:page(about|bespoke|cart|checkout|payment|welcome|customer)",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/mobile/customer/invoice/:order",
      "destination": "/customer/invoice/:order",
      "permanent": true
    },
    {
      "source": "/en/mobile",
      "destination": "/en/home",
      "permanent": true
    },
    {
      "source": "/en/mobile/home",
      "destination": "/en/home",
      "permanent": true
    },
    {
      "source": "/en/mobile/dashboard",
      "destination": "/en/home",
      "permanent": true
    },
    {
      "source": "/en/mobile/catalog",
      "destination": "/en/catalog",
      "permanent": true
    },
    {
      "source": "/en/mobile/articles",
      "destination": "/en/journal",
      "permanent": true
    },
    {
      "source": "/en/mobile/products/:slug",
      "destination": "/en/catalog/:slug",
      "permanent": true
    },
    {
      "source": "/en/mobile/articles/:slug",
      "destination": "/en/articles/:slug",
      "permanent": true
    },
    {
      "source": "/en/mobile/:page(about|bespoke|cart|checkout|payment|welcome|customer)",
      "destination": "/en/:page",
      "permanent": true
    },
    {
      "source": "/en/mobile/customer/invoice/:order",
      "destination": "/en/customer/invoice/:order",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.doku.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.doku.com; worker-src 'self' blob:; frame-src 'self' blob: https://*.doku.com; child-src 'self' blob: https://*.doku.com; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://*.doku.com\"), usb=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/shipping/destinations",
      "destination": "/api/shipping/rates"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog/index.html"
    },
    {
      "source": "/bespoke",
      "destination": "/bespoke/index.html"
    },
    {
      "source": "/journal",
      "destination": "/journal/index.html"
    },
    {
      "source": "/en/home",
      "destination": "/en/home/index.html"
    },
    {
      "source": "/en/catalog",
      "destination": "/en/catalog/index.html"
    },
    {
      "source": "/en/bespoke",
      "destination": "/en/bespoke/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
