# Loaded only by `npm run dev:e2e` (vite --mode e2e), on top of .env.
#
# VITE_ADMIN_EMAILS is the app's authoritative admin gate and is baked into the bundle at build time, so
# the e2e admin address must never reach .env — a production build from this machine would ship it. Here
# it is scoped to a mode nothing deploys with.
#
# production-flow-e2e.mjs seeds a session for this address; without it ProtectedRoute treats the seeded
# user as a customer and sends it to the portal, and the admin half of that suite skips.
VITE_ADMIN_EMAILS=admin-e2e@solivagant.test
