# Required by api/orders/expire-reservations.js in EVERY environment (it mass-cancels unpaid orders and
# releases their stock, so it fails closed rather than trusting VERCEL_ENV). Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` on scheduled runs.
CRON_SECRET=

# Comma-separated admin emails allowed into studio (/dashboard etc). Customers who
# sign in with Google are never admin regardless of this.
# THIS GATE FAILS CLOSED: leaving it empty means NOBODY is admin. The old note here said an
# empty value let any password login in, which stopped being true when the fallback was removed
# (it was an instant-admin hole with open signups). Set it, or the studio locks everyone out.
VITE_ADMIN_EMAILS=

# /api/brief-intent (studio brief -> structured scent intent). The endpoint always
# answers 200: without a working AI gateway it returns the local deterministic
# fallback, which is what it has been doing all along. Set AI_GATEWAY_API_KEY to
# actually reach a model. DISABLE_BRIEF_AI_INTENT=1 forces the fallback on purpose.
AI_GATEWAY_API_KEY=
BRIEF_INTENT_MODEL=
DISABLE_BRIEF_AI_INTENT=

# Optional for browser smoke tests. Without these, protected routes are checked
# for login redirects instead of authenticated page content.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
SMOKE_PUBLIC_ARTICLE_ROUTE=
